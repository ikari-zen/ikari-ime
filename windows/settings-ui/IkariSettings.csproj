<Project Sdk="Microsoft.NET.Sdk">
  <!--
    設定画面（ADR 0071 §2。WinUI 3、C#、パッケージなし（MSIX にしない）・自己完結。候補窓と同じ一式）。
    判断は持たない。核（ikari_settings_core.dll。windows/settings）が渡す一覧を描くだけ。通信のライブラリを呼ばない（NFR-17）。
    Mac ではビルドできない（XAML のコンパイラが Windows だけ）。確かめは CI の Windows のジョブと VM。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- exe の名前は pipe::peer の SETTINGS_EXE_NAME と同じに保つ（engine-host が照らす） -->
    <AssemblyName>ikari-settings</AssemblyName>
    <RootNamespace>IkariSettings</RootNamespace>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET の起動のフック（環境変数で別のコードを読み込ませる口）を切る -->
    <StartupHookSupport>false</StartupHookSupport>
    <!-- LibraryImport（ソースの生成）と、核のバイト列のポインタに要る -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NuGet の依存を packages.lock.json で固定する（候補窓と同じ。ADR 0069 §4.1）。CI（CI=true）はロックの通りでなければ失敗する。
         版を上げたら、Windows で dotnet restore を流してロックを更新する -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <IkariCoreDll Condition="'$(IkariCoreDll)' == ''">$(MSBuildThisFileDirectory)..\..\target\release\ikari_settings_core.dll</IkariCoreDll>
  </PropertyGroup>
  <ItemGroup>
    <!-- 版は候補窓（windows/candidate-ui）と同じに固定する（同じ一式を共有するため） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(IkariCoreDll)" Condition="Exists('$(IkariCoreDll)')" Link="ikari_settings_core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="IkariWarnMissingCore" BeforeTargets="Build" Condition="!Exists('$(IkariCoreDll)')">
    <Warning Code="IKARI001" Text="ikari_settings_core.dll が見つかりません（$(IkariCoreDll)）。先に cargo build --release -p ikari-settings-core を流す" />
  </Target>
</Project>
