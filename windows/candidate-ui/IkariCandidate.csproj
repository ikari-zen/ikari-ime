<Project Sdk="Microsoft.NET.Sdk">
  <!--
    候補窓の画面（ADR 0062 §3、§7.3。WinUI 3、C#、パッケージなし（MSIX にしない）・自己完結（.NET と Windows App SDK を同梱））。
    判断は持たない。核（ikari_candidate.dll。windows/candidate）が渡す RenderState を描くだけ。
    Mac ではビルドできない（XAML のコンパイラが Windows だけ）。確かめは CI の Windows のジョブと VM。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>ikari-candidate</AssemblyName>
    <RootNamespace>IkariCandidate</RootNamespace>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET の起動のフック（環境変数で別のコードを読み込ませる口）を切る -->
    <StartupHookSupport>false</StartupHookSupport>
    <!-- LibraryImport（ソースの生成）と、核の知らせ（関数ポインタ）に要る -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NuGet の依存を packages.lock.json で固定する（間接の依存と中身のハッシュまで）。CI（CI=true）と build.ps1 は
         ロックの通りでなければ失敗する。版を上げたら、Windows で dotnet restore を流してロックを更新する -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- 核の DLL（ikari-candidate の crate の release ビルドの成果物）。別の場所なら IkariCoreDll のプロパティで渡す -->
    <IkariCoreDll Condition="'$(IkariCoreDll)' == ''">$(MSBuildThisFileDirectory)..\..\target\release\ikari_candidate.dll</IkariCoreDll>
  </PropertyGroup>
  <ItemGroup>
    <!-- 版は固定する（2026-11-16 に NuGet で確かめた安定版。Windows App SDK はスパイク #368 で動いた版） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- 型は核と同じ .proto から作る（二重に書かない。ADR 0062 §7.3）。サービスは作らない -->
    <Protobuf Include="..\..\proto\ikari\shell\v1\shell.proto" ProtoRoot="..\..\proto" GrpcServices="None" Access="Internal" />
    <Protobuf Include="..\..\proto\ikari\candidate\v1\candidate.proto" ProtoRoot="..\..\proto" GrpcServices="None" Access="Internal" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(IkariCoreDll)" Condition="Exists('$(IkariCoreDll)')" Link="ikari_candidate.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    .proto から作った型を、XAML のコンパイラの前のコンパイル（XamlPreCompile。PrepareResources の中で、BeforeCompile より前）にも渡す。
    Grpc.Tools は BeforeCompile で Compile に足すため、そのままでは XamlPreCompile に型が無く CS0246 になる（CI で起きた）
  -->
  <Target Name="IkariProtobufBeforeXaml" BeforeTargets="MarkupCompilePass1" DependsOnTargets="Protobuf_Compile" />
  <Target Name="IkariWarnMissingCore" BeforeTargets="Build" Condition="!Exists('$(IkariCoreDll)')">
    <Warning Code="IKARI001" Text="ikari_candidate.dll が見つかりません（$(IkariCoreDll)）。先に cargo build --release -p ikari-candidate を流す" />
  </Target>
</Project>
