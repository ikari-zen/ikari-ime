<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 檻役（IkariLMCage.xpc）の entitlement（ADR 0077 §3.4。ADR 0072 §3 の段 2）。
     App Sandbox だけ。network も一時例外も付けない（付けると段 2 の意味がなくなる）。
     檻役が起動する LM の子（ikari-lm-host）は entitlement なしで、この Sandbox を引き継ぐ。
     build.sh は署名のあとに、この 1 つのキーだけであることを検査する。 -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
